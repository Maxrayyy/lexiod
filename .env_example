# 通用 LLM_PARSE 文档解析；不控制 latex 专用识别。
DEFAULT_LLM=gpt-5.6-terra
# PDF 整页视觉识别，生成原始 TeX；优先保证识别质量。
LEXOID_MODEL=gpt-6-astra
# schema 命令/API：按 JSON Schema 提取结构化数据。
LEXOID_SCHEMA_MODEL=gpt-5.6-terra
# formkit extract：表单字段发现及低置信度字段裁图重读。
FORMKIT_MODEL=gpt-6-astra
# 仅用于显式 local API；远程转换不会加载此模型。
DEFAULT_LOCAL_LM=ds4sd/SmolDocling-256M-preview
# 可选自动模型选择器的本地图片特征模型；更换后需重新生成对应特征缓存。
LEXOID_CLIP_MODEL=openai/clip-vit-base-patch32
# 仅 PaddleOCR 混合识别的版面检测使用；纯视觉模式不加载。
PADDLE_LAYOUT_MODEL=PP-DocLayout_plus-L
# prefetch_models.py 的本地权重预下载清单（JSON）；自动补入上面的版面模型。
# 依次包含页面方向、文字检测/识别、表格分类/结构/单元格、表格 OCR、VL 版面和 VL 权重。
# 清单只用于缓存，不启用推理；保持与所安装 PaddleOCR 的默认组件版本匹配。
PADDLE_PREFETCH_MODELS='["PP-LCNet_x1_0_doc_ori","PP-OCRv6_medium_det","PP-OCRv6_medium_rec","PP-LCNet_x1_0_table_cls","SLANeXt_wired","SLANeXt_wireless","RT-DETR-L_wired_table_cell_det","RT-DETR-L_wireless_table_cell_det","PP-OCRv4_server_det","PP-OCRv4_server_rec_doc","PP-DocLayoutV3","PaddleOCR-VL-1.6-0.9B"]'
# 显式 --model/API model 参数优先；修改后需重建容器以加载新环境。
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
HUGGINGFACEHUB_API_TOKEN=""
TOGETHER_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
MINIMAX_API_KEY=""
# 中国大陆用户可改为 https://api.minimaxi.com/v1
MINIMAX_BASE_URL="https://api.minimax.io/v1"
RUN_WEB_RENDER_TESTS=0
